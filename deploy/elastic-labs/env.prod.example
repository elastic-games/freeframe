# Copy to the repository root as .env.prod; never commit the populated file.
POSTGRES_USER=freeframe
POSTGRES_DB=freeframe
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql://freeframe:REPLACE_WITH_RANDOM_SECRET@postgres:5432/freeframe
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_URL=redis://:REPLACE_WITH_RANDOM_SECRET@redis:6379/0
S3_STORAGE=minio
S3_BUCKET=freeframe
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://review-media.elasticlabs.site
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=2
STUDIO_SSO_ENABLED=true
STUDIO_SSO_SECRET=REPLACE_WITH_SHARED_STUDIO_SSO_SECRET
NEXT_PUBLIC_STUDIO_SSO_ENABLED=true
FRONTEND_URL=https://reviews.elasticlabs.site
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://api:8000
# Studio SSO handles member login; SMTP remains available for notifications.
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_USE_TLS=true
API_WORKERS=2
TRANSCODING_CONCURRENCY=1
EMAIL_CONCURRENCY=1
MAINTENANCE_CONCURRENCY=1
NEXT_PUBLIC_UPLOAD_CONCURRENCY=3
TRANSCODER_ENGINE=ffmpeg
TRANSCODER_QUALITIES=1080p,720p
TRANSCODER_SOURCE_COPY=true
